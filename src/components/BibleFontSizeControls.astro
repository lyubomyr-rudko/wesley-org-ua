<div class="bible-font-size-controls" role="group" aria-label="Розмір тексту">
  <button
    class="slide-action-button bible-font-size-button"
    type="button"
    data-bible-font-decrease
    aria-label="Зменшити розмір тексту"
    title="Зменшити розмір тексту"
  >
    <svg class="slide-action-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M6 18 10.5 6h3L18 18" />
      <path d="M8 14h8" />
      <path d="M19 12h4" />
    </svg>
  </button>

  <output
    class="bible-font-size-value"
    data-bible-font-size-value
    aria-live="polite">100%</output>

  <button
    class="slide-action-button bible-font-size-button"
    type="button"
    data-bible-font-increase
    aria-label="Збільшити розмір тексту"
    title="Збільшити розмір тексту"
  >
    <svg class="slide-action-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M4 18 8.5 6h3L16 18" />
      <path d="M6 14h8" />
      <path d="M20 10v8" />
      <path d="M16 14h8" />
    </svg>
  </button>
</div>
