<div class="bible-font-size-controls" role="group" aria-label="Розмір тексту">
  <button
    class="slide-action-button bible-font-size-button"
    type="button"
    data-bible-font-decrease
    aria-label="Зменшити розмір тексту"
    title="Зменшити розмір тексту"
  >
    <svg class="slide-action-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M6 18 10.5 6h3L18 18" />
      <path d="M8 14h8" />
      <path d="M19 12h4" />
    </svg>
  </button>

  <output
    class="bible-font-size-value"
    data-bible-font-size-value
    aria-live="polite">100%</output>

  <button
    class="slide-action-button bible-font-size-button"
    type="button"
    data-bible-font-increase
    aria-label="Збільшити розмір тексту"
    title="Збільшити розмір тексту"
  >
    <svg class="slide-action-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M4 18 8.5 6h3L16 18" />
      <path d="M6 14h8" />
      <path d="M20 10v8" />
      <path d="M16 14h8" />
    </svg>
  </button>
</div>

<script>
  const bibleReader = document.querySelector("[data-bible-reader]");
  const fontDecreaseButton = document.querySelector("[data-bible-font-decrease]");
  const fontIncreaseButton = document.querySelector("[data-bible-font-increase]");
  const fontSizeValue = document.querySelector("[data-bible-font-size-value]");
  const fontSizeStorageKey = "bible-reader-font-step";
  const fontSizeMinStep = -2;
  const fontSizeMaxStep = 3;
  const fontSizeLabels = {
    "-2": "85%",
    "-1": "92%",
    0: "100%",
    1: "115%",
    2: "130%",
    3: "150%",
  };

  const clampFontSizeStep = (step) =>
    Math.min(fontSizeMaxStep, Math.max(fontSizeMinStep, step));

  const readFontSizeStep = () => {
    try {
      const storedStep = Number(window.localStorage.getItem(fontSizeStorageKey));

      return Number.isFinite(storedStep) ? clampFontSizeStep(storedStep) : 0;
    } catch {
      return 0;
    }
  };

  const saveFontSizeStep = (step) => {
    try {
      window.localStorage.setItem(fontSizeStorageKey, String(step));
    } catch {
      // Reading controls should keep working even when storage is unavailable.
    }
  };

  let currentFontSizeStep = readFontSizeStep();

  const setFontSizeStep = (step) => {
    currentFontSizeStep = clampFontSizeStep(step);
    bibleReader?.setAttribute("data-bible-font-step", String(currentFontSizeStep));
    saveFontSizeStep(currentFontSizeStep);

    if (fontSizeValue) {
      fontSizeValue.textContent = fontSizeLabels[currentFontSizeStep] ?? "100%";
    }

    if (fontDecreaseButton) {
      fontDecreaseButton.disabled = currentFontSizeStep <= fontSizeMinStep;
    }

    if (fontIncreaseButton) {
      fontIncreaseButton.disabled = currentFontSizeStep >= fontSizeMaxStep;
    }
  };

  fontDecreaseButton?.addEventListener("click", () => {
    setFontSizeStep(currentFontSizeStep - 1);
  });
  fontIncreaseButton?.addEventListener("click", () => {
    setFontSizeStep(currentFontSizeStep + 1);
  });
  setFontSizeStep(currentFontSizeStep);
</script>
